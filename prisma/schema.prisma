// =============================================================================
//  Prisma schema — UMS System
//  Aligned with Modules 1 (Auth), 2 (Identity/RBAC), 3 (Academic Structure),
//  4 (Employees), 5 (Courses & Teaching), 6 (Attendance), 7 (Students),
//  8 (Exams), 9 (Finance), 10 (Communication).
//
//  Existing legacy models (Faculty profile, Section, Enrollment, Attendance,
//  Grading, Timetable, LeaveRequest, Media, AdmissionRequest) are preserved
//  alongside the new module entities so previously-shipped modules keep
//  working without modification.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
//  MODULE 1 — Auth & Login
//  MODULE 2 — Identity & Access (RBAC)
// =============================================================================

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String @map("password_hash")

  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  photoUrl  String? @map("photo_url")

  status           UserStatus @default(ACTIVE)
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  lastLoginAt      DateTime?  @map("last_login_at")
  /// Incremented on logout / session revoke so access JWTs become invalid immediately.
  tokenVersion     Int        @default(0) @map("token_version")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")

  // RBAC
  userRoles UserRole[]
  scope     UserScope?

  // Auth
  refreshTokens RefreshToken[]

  // Profiles (1:1)
  student  Student?
  faculty  Faculty?
  employee Employee?

  // Cross-module
  uploadedMedia Media[]
  leaveRequests LeaveRequest[]

  // Module 10 — Communication
  notifications     Notification[]
  messagesSent      Message[]      @relation("MessageSender")
  messagesReceived  Message[]      @relation("MessageRecipient")
  announcements     Announcement[]

  @@index([email])
  @@index([status])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique @map("token_hash")
  issuedAt   DateTime  @default(now()) @map("issued_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address")

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Role {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  code        String  @unique
  module      String
  resource    String
  action      String
  description String?

  rolePermissions RolePermission[]

  @@index([module, resource])
  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     String   @map("role_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by")

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  grantedAt    DateTime   @default(now()) @map("granted_at")
  grantedBy    String?    @map("granted_by")

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserScope {
  userId        String   @id @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  campusIds     String[] @default([]) @map("campus_ids")
  departmentIds String[] @default([]) @map("department_ids")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_scopes")
}

// =============================================================================
//  MODULE 3 — Academic Structure
// =============================================================================

enum EntityStatus {
  ACTIVE
  INACTIVE
}

enum ProgramLevel {
  BS
  MS
  PHD
  DIPLOMA
}

model Campus {
  id      String       @id @default(uuid())
  code    String       @unique
  name    String
  city    String?
  address String?
  phone   String?
  email   String?
  status  EntityStatus @default(ACTIVE)

  faculties AcademicFaculty[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@index([status])
  @@map("campuses")
}

model AcademicFaculty {
  id       String       @id @default(uuid())
  code     String       @unique
  name     String
  campusId String       @map("campus_id")
  campus   Campus       @relation(fields: [campusId], references: [id], onDelete: Restrict)
  /// Legacy free-text dean name (Module 3 stub). Module 4 introduces deanEmployeeId FK.
  dean     String?
  email    String?
  status   EntityStatus @default(ACTIVE)

  // Module 4 — FK to employee acting as dean
  deanEmployeeId String?   @map("dean_employee_id")
  deanEmployee   Employee? @relation("FacultyDean", fields: [deanEmployeeId], references: [id], onDelete: SetNull)

  departments Department[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@unique([campusId, name])
  @@index([campusId])
  @@index([status])
  @@map("academic_faculties")
}

model Department {
  id                String          @id @default(uuid())
  code              String          @unique
  name              String
  academicFacultyId String          @map("academic_faculty_id")
  academicFaculty   AcademicFaculty @relation(fields: [academicFacultyId], references: [id], onDelete: Restrict)
  /// Legacy free-text head name (Module 3 stub). Module 4 introduces headEmployeeId FK.
  head              String?
  email             String?
  status            EntityStatus    @default(ACTIVE)

  // Module 4 — FK to employee acting as department head
  headEmployeeId String?   @map("head_employee_id")
  headEmployee   Employee? @relation("DepartmentHead", fields: [headEmployeeId], references: [id], onDelete: SetNull)

  programs Program[]
  courses  Course[]
  faculty  Faculty[]

  // Module 4 — primary department + cross-listings
  employees             Employee[]           @relation("EmployeePrimaryDept")
  employeeDepartments   EmployeeDepartment[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@index([academicFacultyId])
  @@index([status])
  @@map("departments")
}

model Program {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  departmentId  String       @map("department_id")
  department    Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  level         ProgramLevel @default(BS)
  durationYears Int          @default(4) @map("duration_years")
  totalCredits  Int          @default(132) @map("total_credits")
  status        EntityStatus @default(ACTIVE)

  batches           Batch[]
  students          Student[]
  admissionRequests AdmissionRequest[]
  programCourses    ProgramCourse[]
  semesterCourses   SemesterCourse[]

  // Module 7 / 9
  enrollmentHistory EnrollmentHistory[]
  feeStructures     FeeStructure[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@unique([departmentId, name])
  @@index([departmentId])
  @@index([status])
  @@map("programs")
}

model AcademicSession {
  id        String       @id @default(uuid())
  code      String       @unique
  name      String
  startDate DateTime     @map("start_date") @db.Date
  endDate   DateTime     @map("end_date") @db.Date
  status    EntityStatus @default(ACTIVE)

  batches   Batch[]
  semesters Semester[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@index([status])
  @@index([startDate])
  @@map("academic_sessions")
}

model Semester {
  id        String          @id @default(uuid())
  name      String
  sessionId String          @map("session_id")
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  sequence  Int
  startDate DateTime        @map("start_date") @db.Date
  endDate   DateTime        @map("end_date") @db.Date
  status    EntityStatus    @default(ACTIVE)

  sections        Section[]
  students        Student[]
  semesterCourses SemesterCourse[]

  // Module 5 / 7 / 9
  offerings         Offering[]
  enrollmentHistory EnrollmentHistory[]
  invoices          Invoice[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@unique([sessionId, sequence])
  @@index([sessionId])
  @@index([status])
  @@map("semesters")
}

model Batch {
  id        String          @id @default(uuid())
  name      String
  programId String          @map("program_id")
  sessionId String          @map("session_id")
  program   Program         @relation(fields: [programId], references: [id], onDelete: Restrict)
  session   AcademicSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  startYear Int             @map("start_year")
  endYear   Int             @map("end_year")
  intake    Int             @default(0)
  status    EntityStatus    @default(ACTIVE)

  students          Student[]
  admissionRequests AdmissionRequest[]

  // Module 5 / 7
  offerings         Offering[]
  enrollmentHistory EnrollmentHistory[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@unique([programId, sessionId])
  @@index([programId])
  @@index([sessionId])
  @@index([status])
  @@map("batches")
}

// =============================================================================
//  CROSS-MODULE — Curriculum joins
// =============================================================================

model ProgramCourse {
  id        String @id @default(uuid())
  programId String @map("program_id")
  courseId  String @map("course_id")

  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([programId, courseId])
  @@map("program_courses")
}

model SemesterCourse {
  id         String @id @default(uuid())
  semesterId String @map("semester_id")
  courseId   String @map("course_id")
  programId  String @map("program_id")

  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  program  Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([semesterId, courseId])
  @@map("semester_courses")
}

// =============================================================================
//  PROFILES — Student & Faculty (legacy employee profile) — preserved
// =============================================================================

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
  PENDING
}

/// Module 7 — Student academic-state machine. Renamed to avoid clashing with the
/// existing Enrollment.status enum (see `EnrollmentStatus` below).
enum StudentEnrollmentStatus {
  ACTIVE
  GRADUATED
  DROPPED
  TRANSFERRED
  ON_LEAVE
}

model Student {
  id              String  @id @default(uuid())
  /// Optional — Module 7 supports HR-style records that don't yet have a login.
  userId          String? @unique @map("user_id")
  user            User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  programId       String? @map("program_id")
  firstName       String  @map("first_name")
  lastName        String  @map("last_name")
  regNo           String  @unique @map("reg_no")
  /// Module 7 — formal admission number ("STD-YYYY-NNNNN"). Optional for legacy data.
  admissionNumber String? @unique @map("admission_number")

  status           StudentStatus           @default(ACTIVE)
  enrollmentStatus StudentEnrollmentStatus @default(ACTIVE) @map("enrollment_status")
  enrolledAt       DateTime?               @map("enrolled_at") @db.Date

  profilePhoto String? @map("profile_photo")
  phone        String?
  email        String?
  gender       String?
  bloodGroup   String? @map("blood_group")
  nationality  String?
  address      String?
  dateOfBirth  DateTime? @map("date_of_birth")
  cnic         String?   @unique

  program           Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  batchId           String?           @map("batch_id")
  batch             Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  currentSemesterId String?           @map("current_semester_id")
  currentSemester   Semester?         @relation(fields: [currentSemesterId], references: [id])
  enrollments       Enrollment[]
  media             Media[]
  guardians         StudentGuardian[]

  // Module 6 / 7 / 8 / 9
  enrollmentHistory EnrollmentHistory[]
  attendanceRecords AttendanceRecord[]
  marks             Marks[]
  invoices          Invoice[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")

  @@index([programId])
  @@index([batchId])
  @@index([currentSemesterId])
  @@index([status])
  @@index([enrollmentStatus])
  @@map("students")
}

enum GuardianRelation {
  FATHER
  MOTHER
  GUARDIAN
  SIBLING
  SPOUSE
  OTHER
}

model Guardian {
  id String @id @default(uuid())

  firstName  String  @map("first_name")
  lastName   String  @map("last_name")
  /// Optional in Module 7 spec. Existing rows already carry a value.
  phone      String?
  email      String?
  /// Optional + unique. Pakistani NIC-style identifier.
  cnic       String? @unique
  occupation String?
  address    String?
  photoUrl   String? @map("photo_url")

  students StudentGuardian[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")

  @@map("guardians")
}

model StudentGuardian {
  id String @id @default(uuid())

  studentId  String  @map("student_id")
  guardianId String  @map("guardian_id")
  relation   String?
  isPrimary  Boolean @default(false) @map("is_primary")

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@unique([studentId, guardianId])
  @@index([guardianId])
  @@map("student_guardians")
}

model Faculty {
  id          String  @id @default(uuid())
  userId      String  @unique @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName   String  @map("first_name")
  lastName    String  @map("last_name")
  empId       String  @unique @map("emp_id")
  designation String
  phone       String?

  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sections     Section[]
  media        Media[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faculty")
}

// =============================================================================
//  MODULE 4 — Employees
//  HR record for everyone who works at the institution. Optionally links to
//  a User (login account). Module 5's CourseAssignment.teacherId references
//  Employee.id where role = TEACHER.
// =============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmployeeRole {
  TEACHER
  STAFF
  LIBRARIAN
  FINANCE
  IT_SUPPORT
  OTHER
}

enum EmployeeType {
  FACULTY
  NON_FACULTY
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  VISITING
}

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  INACTIVE
}

model Employee {
  id             String    @id @default(uuid())
  employeeNumber String    @unique @map("employee_number")
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  email          String    @unique
  phone          String?
  dob            DateTime? @db.Date
  gender         Gender?
  address        String?
  nationality    String?
  cnic           String?   @unique

  role           EmployeeRole
  employeeType   EmployeeType   @map("employee_type")
  designation    String
  employmentType EmploymentType @map("employment_type")
  joiningDate    DateTime       @map("joining_date") @db.Date
  status         EmployeeStatus @default(ACTIVE)

  primaryDepartmentId String?     @map("primary_department_id")
  primaryDepartment   Department? @relation("EmployeePrimaryDept", fields: [primaryDepartmentId], references: [id], onDelete: SetNull)

  photoUrl String? @map("photo_url")

  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  departments EmployeeDepartment[]

  // Reverse relations from Module 3 (FK promotion)
  facultiesAsDean   AcademicFaculty[] @relation("FacultyDean")
  departmentsAsHead Department[]      @relation("DepartmentHead")

  // Module 5 — teaching
  courseAssignments CourseAssignment[]
  timetableSlots    TimetableSlot[]

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")

  @@index([role])
  @@index([status])
  @@index([primaryDepartmentId])
  @@index([userId])
  @@map("employees")
}

model EmployeeDepartment {
  employeeId   String   @map("employee_id")
  departmentId String   @map("department_id")
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  assignedAt   DateTime @default(now()) @map("assigned_at")

  @@id([employeeId, departmentId])
  @@map("employee_departments")
}

// =============================================================================
//  MODULE 5 — Courses & Teaching
//  Course (existing) + new Classroom / Offering / CourseAssignment / TimetableSlot
// =============================================================================

enum CourseType {
  THEORY
  LAB
  SEMINAR
  RESEARCH
}

model Course {
  id           String     @id @default(uuid())
  title        String
  code         String     @unique
  creditHours  Int        @map("credit_hours")
  departmentId String     @map("department_id")
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  // Module 5 — additive
  type        CourseType?
  description String?
  status      EntityStatus @default(ACTIVE)

  sections        Section[]
  media           Media[]
  programCourses  ProgramCourse[]
  semesterCourses SemesterCourse[]

  offerings Offering[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([departmentId])
  @@index([status])
  @@map("courses")
}

enum ClassroomType {
  LECTURE
  LAB
  SEMINAR
  STUDIO
}

enum ClassroomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

model Classroom {
  id       String          @id @default(uuid())
  code     String          @unique
  name     String
  capacity Int
  building String?
  type     ClassroomType
  status   ClassroomStatus @default(ACTIVE)

  slots TimetableSlot[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@index([status])
  @@map("classrooms")
}

enum OfferingStatus {
  OPEN
  CLOSED
  FULL
}

model Offering {
  id         String         @id @default(uuid())
  courseId   String         @map("course_id")
  semesterId String         @map("semester_id")
  batchId    String         @map("batch_id")
  section    String
  capacity   Int
  status     OfferingStatus @default(OPEN)

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Restrict)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)

  assignments        CourseAssignment[]
  slots              TimetableSlot[]
  attendanceSessions AttendanceSession[]
  exams              Exam[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@unique([courseId, semesterId, batchId, section])
  @@index([courseId])
  @@index([semesterId])
  @@index([batchId])
  @@index([status])
  @@map("offerings")
}

enum AssignmentRole {
  PRIMARY
  CO_PRIMARY
  TA
}

model CourseAssignment {
  id         String         @id @default(uuid())
  offeringId String         @map("offering_id")
  teacherId  String         @map("teacher_id")
  role       AssignmentRole @default(PRIMARY)

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  teacher  Employee @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id")

  @@unique([offeringId, teacherId])
  @@index([offeringId])
  @@index([teacherId])
  @@map("course_assignments")
}

enum Day {
  MON
  TUE
  WED
  THU
  FRI
  SAT
}

model TimetableSlot {
  id         String @id @default(uuid())
  offeringId String @map("offering_id")
  teacherId  String @map("teacher_id")
  roomId     String @map("room_id")
  day        Day
  startTime  String @map("start_time")
  endTime    String @map("end_time")

  offering Offering  @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  teacher  Employee  @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  room     Classroom @relation(fields: [roomId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@index([offeringId])
  @@index([teacherId, day])
  @@index([roomId, day])
  @@map("timetable_slots")
}

// =============================================================================
//  LEGACY Section / Enrollment / Attendance / Grading / Timetable — preserved.
//  These power the Section / Enrollment / Attendance / Grading / Timetable
//  modules that were live before Module 5 introduced the Offering model.
// =============================================================================

model Section {
  id         String @id @default(uuid())
  name       String
  courseId   String @map("course_id")
  facultyId  String @map("faculty_id")
  semesterId String @map("semester_id")
  maxSeats   Int    @default(40) @map("max_seats")

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty  Faculty  @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  enrollments Enrollment[]
  timetables  Timetable[]
  media       Media[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([courseId, name, semesterId])
  @@map("sections")
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
}

model Enrollment {
  id         String           @id @default(uuid())
  studentId  String           @map("student_id")
  sectionId  String           @map("section_id")
  status     EnrollmentStatus @default(ENROLLED)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  attendance Attendance[]
  grading    Grading?

  @@unique([studentId, sectionId])
  @@map("enrollments")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

model Attendance {
  id           String           @id @default(uuid())
  enrollmentId String           @map("enrollment_id")
  date         DateTime
  status       AttendanceStatus
  remarks      String?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([enrollmentId, date])
  @@map("attendance")
}

model Grading {
  id           String @id @default(uuid())
  enrollmentId String @unique @map("enrollment_id")

  assignment Float? @default(0)
  quiz       Float? @default(0)
  midterm    Float? @default(0)
  finalExam  Float? @default(0) @map("final_exam")

  totalMarks Float?  @map("total_marks")
  grade      String?
  gpa        Float?
  remarks    String?

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("grading")
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model Timetable {
  id        String   @id @default(uuid())
  sectionId String   @map("section_id")
  day       WeekDay
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  room      String?

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("timetables")
}

// =============================================================================
//  MODULE 6 — Attendance (sessions + records)
// =============================================================================

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model AttendanceSession {
  id         String        @id @default(uuid())
  offeringId String        @map("offering_id")
  offering   Offering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  date       DateTime      @db.Date
  startTime  String        @map("start_time")
  endTime    String        @map("end_time")
  topic      String?
  notes      String?
  status     SessionStatus @default(SCHEDULED)
  markedAt   DateTime?     @map("marked_at")

  records AttendanceRecord[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@unique([offeringId, date, startTime])
  @@index([offeringId])
  @@index([date])
  @@index([status])
  @@map("attendance_sessions")
}

model AttendanceRecord {
  id        String           @id @default(uuid())
  sessionId String           @map("session_id")
  studentId String           @map("student_id")
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Restrict)
  status    AttendanceStatus
  notes     String?
  markedAt  DateTime         @default(now()) @map("marked_at")
  markedBy  String?          @map("marked_by")

  @@unique([sessionId, studentId])
  @@index([sessionId])
  @@index([studentId])
  @@index([status])
  @@map("attendance_records")
}

// =============================================================================
//  MODULE 7 — Enrollment History (per-semester transition log)
// =============================================================================

enum EnrollmentSemesterStatus {
  ACTIVE
  COMPLETED
  INCOMPLETE
}

model EnrollmentHistory {
  id         String                   @id @default(uuid())
  studentId  String                   @map("student_id")
  programId  String                   @map("program_id")
  batchId    String                   @map("batch_id")
  semesterId String                   @map("semester_id")
  status     EnrollmentSemesterStatus
  startedAt  DateTime                 @map("started_at") @db.Date
  endedAt    DateTime?                @map("ended_at") @db.Date

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  program  Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  batch    Batch    @relation(fields: [batchId], references: [id], onDelete: Restrict)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by_id")

  @@index([studentId])
  @@index([semesterId])
  @@map("enrollment_history")
}

// =============================================================================
//  MODULE 8 — Exams & Results
// =============================================================================

model ExamType {
  id     String       @id @default(uuid())
  name   String       @unique
  weight Int
  status EntityStatus @default(ACTIVE)

  exams Exam[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("exam_types")
}

enum ExamStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

model Exam {
  id         String     @id @default(uuid())
  offeringId String     @map("offering_id")
  examTypeId String     @map("exam_type_id")
  name       String
  date       DateTime   @db.Date
  totalMarks Int        @map("total_marks")
  status     ExamStatus @default(SCHEDULED)
  notes      String?

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  examType ExamType @relation(fields: [examTypeId], references: [id], onDelete: Restrict)
  marks    Marks[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@index([offeringId])
  @@index([examTypeId])
  @@index([date])
  @@index([status])
  @@map("exams")
}

model Marks {
  id        String  @id @default(uuid())
  examId    String  @map("exam_id")
  studentId String  @map("student_id")
  obtained  Decimal @db.Decimal(6, 2)
  remarks   String?

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  enteredAt DateTime @default(now()) @map("entered_at")
  enteredBy String?  @map("entered_by")

  @@unique([examId, studentId])
  @@index([examId])
  @@index([studentId])
  @@map("marks")
}

model GradingScheme {
  id          String  @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean @default(false) @map("is_default")

  tiers GradingTier[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("grading_schemes")
}

model GradingTier {
  id       String  @id @default(uuid())
  schemeId String  @map("scheme_id")
  letter   String
  min      Decimal @db.Decimal(5, 2)
  gpa      Decimal @db.Decimal(3, 2)

  scheme GradingScheme @relation(fields: [schemeId], references: [id], onDelete: Cascade)

  @@unique([schemeId, letter])
  @@unique([schemeId, min])
  @@index([schemeId])
  @@map("grading_tiers")
}

// =============================================================================
//  MODULE 9 — Fees & Finance
// =============================================================================

enum FeeType {
  TUITION
  ADMISSION
  LIBRARY
  LAB
  EXAM
  TRANSPORT
  HOSTEL
  OTHER
}

model FeeStructure {
  id              String       @id @default(uuid())
  programId       String       @map("program_id")
  name            String
  description     String?
  status          EntityStatus @default(ACTIVE)
  appliesFromYear Int          @map("applies_from_year")

  program Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  items   FeeItem[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdById String?  @map("created_by_id")
  updatedById String?  @map("updated_by_id")

  @@unique([programId, appliesFromYear])
  @@index([programId])
  @@index([status])
  @@map("fee_structures")
}

model FeeItem {
  id          String  @id @default(uuid())
  structureId String  @map("structure_id")
  name        String
  amount      Decimal @db.Decimal(12, 2)
  type        FeeType
  required    Boolean @default(true)
  oneTime     Boolean @default(false) @map("one_time")

  structure FeeStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([structureId])
  @@map("fee_items")
}

model Invoice {
  id            String    @id @default(uuid())
  invoiceNumber String    @unique @map("invoice_number")
  studentId     String    @map("student_id")
  semesterId    String    @map("semester_id")
  issueDate     DateTime  @map("issue_date") @db.Date
  dueDate       DateTime  @map("due_date") @db.Date

  discount Decimal @db.Decimal(12, 2) @default(0)
  tax      Decimal @db.Decimal(12, 2) @default(0)
  notes    String?

  approvedAt    DateTime? @map("approved_at")
  approvedById  String?   @map("approved_by_id")
  cancelledAt   DateTime? @map("cancelled_at")
  cancelledById String?   @map("cancelled_by_id")
  cancelReason  String?   @map("cancel_reason")

  items    InvoiceItem[]
  payments Payment[]

  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  student  Student  @relation(fields: [studentId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")

  @@index([studentId])
  @@index([semesterId])
  @@index([dueDate])
  @@index([cancelledAt])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String  @map("invoice_id")
  name      String
  amount    Decimal @db.Decimal(12, 2)
  type      FeeType
  notes     String?

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  ONLINE
  CHEQUE
}

model Payment {
  id           String        @id @default(uuid())
  invoiceId    String        @map("invoice_id")
  amount       Decimal       @db.Decimal(12, 2)
  method       PaymentMethod
  reference    String?
  paidAt       DateTime      @map("paid_at") @db.Date
  notes        String?
  recordedById String        @map("recorded_by_id")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([invoiceId])
  @@index([paidAt])
  @@map("payments")
}

// =============================================================================
//  MODULE 10 — Communication
// =============================================================================

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  DANGER
}

model Notification {
  id      String           @id @default(uuid())
  userId  String           @map("user_id")
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type    NotificationType
  title   String
  message String
  link    String?
  readAt  DateTime?        @map("read_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Message {
  id          String    @id @default(uuid())
  threadId    String    @map("thread_id")
  senderId    String    @map("sender_id")
  recipientId String    @map("recipient_id")
  subject     String
  body        String
  readAt      DateTime? @map("read_at")

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([threadId, createdAt])
  @@index([senderId])
  @@index([recipientId, readAt])
  @@map("messages")
}

enum AnnouncementAudience {
  ALL
  STUDENTS
  FACULTY
  STAFF
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Announcement {
  id          String                 @id @default(uuid())
  title       String
  body        String
  audience    AnnouncementAudience[]
  authorId    String                 @map("author_id")
  status      AnnouncementStatus     @default(DRAFT)
  publishedAt DateTime?              @map("published_at")
  expiresAt   DateTime?              @map("expires_at")

  author User @relation(fields: [authorId], references: [id], onDelete: Restrict)

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  createdById String?   @map("created_by_id")
  updatedById String?   @map("updated_by_id")
  deletedAt   DateTime? @map("deleted_at")

  @@index([status])
  @@index([publishedAt])
  @@map("announcements")
}

// =============================================================================
//  LEAVE REQUESTS — preserved
// =============================================================================

enum LeaveType {
  MEDICAL
  PERSONAL
  EMERGENCY
  OFFICIAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model LeaveRequest {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  type       LeaveType
  reason     String
  fromDate   DateTime    @map("from_date")
  toDate     DateTime    @map("to_date")
  status     LeaveStatus @default(PENDING)
  reviewedBy String?     @map("reviewed_by")
  remarks    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("leave_requests")
}

// =============================================================================
//  ADMISSIONS — preserved
// =============================================================================

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdmissionRequest {
  id          String          @id @default(uuid())
  email       String
  firstName   String
  lastName    String
  status      AdmissionStatus @default(PENDING)
  phone       String?
  address     String?
  dateOfBirth DateTime?

  programId String
  program   Program @relation(fields: [programId], references: [id])
  batchId   String?
  batch     Batch?  @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admission_requests")
}

// =============================================================================
//  MEDIA — preserved
// =============================================================================

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Media {
  id       String    @id @default(uuid())
  url      String
  fileName String
  fileType MediaType
  size     Int?

  uploadedById String @map("uploaded_by")
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  studentId String?  @map("student_id")
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  facultyId String?  @map("faculty_id")
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  courseId String? @map("course_id")
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  sectionId String?  @map("section_id")
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}
