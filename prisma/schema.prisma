generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  STUDENT
  FACULTY
  ADMIN
  STAFF
  SECURITY
}

// ─── MODULE 1: USER ──────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // 1:1 profile relations
  student       Student?
  faculty       Faculty?

  // 1:M token relation
  refreshTokens RefreshToken[]

  @@map("users")
}

model Student {
  id          String    @id @default(uuid())
  userId      String    @unique @map("user_id")
  programId   String?   @map("program_id")
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  regNo       String    @unique @map("reg_no")
  batch       String
  phone       String?
  address     String?
  dateOfBirth DateTime? @map("date_of_birth")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  program     Program?  @relation(fields: [programId], references: [id], onDelete: SetNull)

  @@map("students")
}

model Faculty {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  departmentId String? @map("department_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  empId       String   @unique @map("emp_id")
  designation String
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department  Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sections    Section[]

  @@map("faculty")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Department {
  id        String    @id @default(uuid())
  name      String    @unique
  code      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  programs  Program[]
  courses   Course[]
  faculty   Faculty[]

  @@map("departments")
}

model Program {
  id           String    @id @default(uuid())
  name         String
  code         String    @unique
  departmentId String    @map("department_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students     Student[]

  @@unique([departmentId, name])
  @@map("programs")
}

model Course {
  id           String    @id @default(uuid())
  title        String
  code         String    @unique
  creditHours  Int       @map("credit_hours")
  departmentId String    @map("department_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  sections     Section[]

  @@map("courses")
}

model Semester {
  id        String    @id @default(uuid())
  name      String    @unique
  startDate DateTime  @map("start_date")
  endDate   DateTime  @map("end_date")
  isActive  Boolean   @default(false) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  sections  Section[]

  @@map("semesters")
}

model Section {
  id         String    @id @default(uuid())
  name       String
  courseId   String    @map("course_id")
  facultyId  String    @map("faculty_id")
  semesterId String    @map("semester_id")
  maxSeats   Int       @default(40) @map("max_seats")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty    Faculty   @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  semester   Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([courseId, name, semesterId])
  @@map("sections")
}