generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  roles        UserRole[]
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // 1:1 profile relations
  student       Student?
  faculty       Faculty?
  uploadedMedia Media[]
  leaveRequests LeaveRequest[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model Media {
  id       String    @id @default(uuid())
  url      String
  fileName String
  fileType MediaType
  size     Int?

  // Who uploaded
  uploadedById String @map("uploaded_by")
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  // Optional relations (VERY FLEXIBLE DESIGN)
  studentId String?  @map("student_id")
  student   Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)

  facultyId String?  @map("faculty_id")
  faculty   Faculty? @relation(fields: [facultyId], references: [id], onDelete: Cascade)

  courseId String? @map("course_id")
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)

  sectionId String?  @map("section_id")
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media")
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

model Campus {
  id      String  @id @default(uuid())
  name    String  @unique
  code    String  @unique
  address String?
  city    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  faculties AcademicFaculty[]

  @@map("campuses")
}

model AcademicFaculty {
  id       String @id @default(uuid())
  name     String
  code     String @unique
  campusId String @map("campus_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  campus      Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  departments Department[]

  @@unique([campusId, name])
  @@map("academic_faculties")
}

model Batch {
  id        String @id @default(uuid())
  name      String // e.g. "BSCS-2023"
  startYear Int
  endYear   Int?
  programId String @map("program_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  program           Program            @relation(fields: [programId], references: [id], onDelete: Cascade)
  students          Student[]
  admissionRequests AdmissionRequest[]

  @@unique([programId, name])
  @@map("batches")
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique // ADMIN, STUDENT, etc
  description String?

  users       UserRole[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique // e.g. "attendance.view"
  module      String  @default("Academic")
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("permissions")
}

model UserRole {
  id String @id @default(uuid())

  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id String @id @default(uuid())

  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model AdmissionRequest {
  id          String          @id @default(uuid())
  email       String
  firstName   String
  lastName    String
  status      AdmissionStatus // PENDING, APPROVED, REJECTED
  phone       String?
  address     String?
  dateOfBirth DateTime?

  programId String
  program   Program @relation(fields: [programId], references: [id])
  batchId   String?
  batch     Batch?  @relation(fields: [batchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProgramCourse {
  id        String @id @default(uuid())
  programId String
  courseId  String

  program Program @relation(fields: [programId], references: [id])
  course  Course  @relation(fields: [courseId], references: [id])

  @@unique([programId, courseId])
}

model Student {
  id        String  @id @default(uuid())
  userId    String  @unique @map("user_id")
  programId String? @map("program_id")
  firstName String  @map("first_name")
  lastName  String  @map("last_name")
  regNo     String  @unique @map("reg_no")

  status StudentStatus @default(ACTIVE)

  profilePhoto String?
  phone        String?
  email        String? // optional (already in User)
  gender       String?
  bloodGroup   String?
  nationality  String?
  address      String?

  dateOfBirth DateTime?

  // Relations
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  program           Program?          @relation(fields: [programId], references: [id], onDelete: SetNull)
  batchId           String?           @map("batch_id")
  batch             Batch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  currentSemesterId String?
  currentSemester   Semester?         @relation(fields: [currentSemesterId], references: [id])
  enrollments       Enrollment[]
  media             Media[]
  guardians         StudentGuardian[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("students")
}

model Guardian {
  id String @id @default(uuid())

  firstName  String
  lastName   String
  phone      String
  email      String?
  cnic       String  @unique
  occupation String?
  address    String?

  // relation
  students StudentGuardian[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model StudentGuardian {
  id String @id @default(uuid())

  studentId  String
  guardianId String

  relation String? // Father, Mother, Uncle etc

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@unique([studentId, guardianId])
}

model Faculty {
  id          String   @id @default(uuid())
  userId      String   @unique @map("user_id")
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  empId       String   @unique @map("emp_id")
  designation String
  phone       String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String?     @map("department_id")
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  sections     Section[]
  media        Media[]

  @@map("faculty")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  programs          Program[]
  courses           Course[]
  faculty           Faculty[]
  academicFacultyId String?          @map("academic_faculty_id")
  academicFaculty   AcademicFaculty? @relation(fields: [academicFacultyId], references: [id], onDelete: Cascade)

  @@map("departments")
}

model Program {
  id           String   @id @default(uuid())
  name         String
  code         String   @unique
  departmentId String   @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department        Department         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  students          Student[]
  batches           Batch[]
  semesters         Semester[]
  admissionRequests AdmissionRequest[]
  programCourses    ProgramCourse[]
  semesterCourses   SemesterCourse[]

  @@unique([departmentId, name])
  @@map("programs")
}

model Course {
  id           String   @id @default(uuid())
  title        String
  code         String   @unique
  creditHours  Int      @map("credit_hours")
  departmentId String   @map("department_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  sections   Section[]
  media      Media[]

  programCourses  ProgramCourse[]
  semesterCourses SemesterCourse[]

  @@map("courses")
}

model SemesterCourse {
  id         String @id @default(uuid())
  semesterId String
  courseId   String
  programId  String

  semester Semester @relation(fields: [semesterId], references: [id])
  course   Course   @relation(fields: [courseId], references: [id])
  program  Program  @relation(fields: [programId], references: [id])

  @@unique([semesterId, courseId])
}

model Semester {
  id           String   @id @default(uuid())
  name         String   @unique
  academicYear String
  startDate    DateTime @map("start_date")
  endDate      DateTime @map("end_date")
  isActive     Boolean  @default(false) @map("is_active")

  programId String?  @map("program_id") // 👈 optional link
  program   Program? @relation(fields: [programId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sections        Section[]
  students        Student[]
  semesterCourses SemesterCourse[]

  @@unique([name, programId])
  @@map("semesters")
}

model Section {
  id          String       @id @default(uuid())
  name        String
  courseId    String       @map("course_id")
  facultyId   String       @map("faculty_id")
  semesterId  String       @map("semester_id")
  maxSeats    Int          @default(40) @map("max_seats")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  enrollments Enrollment[]
  timetables  Timetable[]
  media       Media[]

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  faculty  Faculty  @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)

  @@unique([courseId, name, semesterId])
  @@map("sections")
}

model Enrollment {
  id         String           @id @default(uuid())
  studentId  String           @map("student_id")
  sectionId  String           @map("section_id")
  status     EnrollmentStatus @default(ENROLLED)
  enrolledAt DateTime         @default(now()) @map("enrolled_at")

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  attendance Attendance[]
  grading    Grading?

  @@unique([studentId, sectionId]) // prevent duplicate enrollment
  @@map("enrollments")
}

enum EnrollmentStatus {
  ENROLLED
  DROPPED
  COMPLETED
}

model Attendance {
  id           String           @id @default(uuid())
  enrollmentId String           @map("enrollment_id")
  date         DateTime
  status       AttendanceStatus
  remarks      String?
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  // Relations
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date]) // prevent duplicate attendance per day
  @@map("attendance")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

model Grading {
  id           String @id @default(uuid())
  enrollmentId String @unique @map("enrollment_id")

  // Marks
  assignment Float? @default(0)
  quiz       Float? @default(0)
  midterm    Float? @default(0)
  finalExam  Float? @default(0) @map("final_exam")

  totalMarks Float?  @map("total_marks")
  grade      String? // A, B, C
  gpa        Float? // 4.0 scale

  remarks String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relation
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("grading")
}

model Timetable {
  id        String   @id @default(uuid())
  sectionId String   @map("section_id")
  day       WeekDay
  startTime DateTime @map("start_time")
  endTime   DateTime @map("end_time")
  room      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@map("timetables")
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model LeaveRequest {
  id         String      @id @default(uuid())
  userId     String      @map("user_id")
  type       LeaveType
  reason     String
  fromDate   DateTime    @map("from_date")
  toDate     DateTime    @map("to_date")
  status     LeaveStatus @default(PENDING)
  reviewedBy String?     @map("reviewed_by")
  remarks    String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

enum LeaveType {
  MEDICAL
  PERSONAL
  EMERGENCY
  OFFICIAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
}
